# Configuration du Serveur FastAPI
PORT=8000
HOST=127.0.0.1

# Configuration d'Ollama (IA Locale)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Configuration CORS (Frontend Next.js autorisé)
FRONTEND_URL=http://localhost:3000

# ==========================================
# Configuration Keycloak (SSO / OIDC)
# ==========================================
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=benchflow
KEYCLOAK_CLIENT_ID=benchflow-app

# ==========================================
# Base de Données Relationnelle (SQLAlchemy)
# ==========================================
DATABASE_URL=sqlite:///./data/benchflow.db
